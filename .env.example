# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application, redirect URI http://127.0.0.1:8123/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any random string -- only used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Optional. When both are set, startup creates a demo adjuster with this password, or
# re-applies this password if the account already exists -- so changing the password here
# and restarting rotates it. Change only the password to rotate; a new username creates a
# second account and leaves the old one working. For hosts with no shell, such as Azure
# App Service free tier. Leave blank locally.
DEMO_ADJUSTER_USERNAME=
DEMO_ADJUSTER_PASSWORD=

# Optional real email (Azure Communication Services). Leave EMAIL_PROVIDER blank to keep email
# simulated. See README, "Real email".
EMAIL_PROVIDER=
# Set to false to keep email simulated without clearing the settings below.
EMAIL_ENABLED=
ACS_CONNECTION_STRING=
EMAIL_SENDER_ADDRESS=
# Public address of the site, for the links in emails (hosted site only), e.g. https://<app>.azurewebsites.net
APP_BASE_URL=
# Inbox that is emailed when a claim is ready for review.
ADJUSTER_NOTIFY_EMAIL=

# Optional AI agents (Phase 5). Leave AI_PROVIDER blank to keep AI off: no model is ever called.
# Set it to "openrouter" to enable. See README and docs/design/AGENTS.md.
AI_PROVIDER=
# Set to false to switch AI off without clearing the settings below.
AI_ENABLED=
# From https://openrouter.ai/keys -- a secret; never commit it.
OPENROUTER_API_KEY=
# Model IDs in order of preference, comma-separated; the next is tried when one is busy or down.
# Only models that passed the probe/bake-off (never "openrouter/free"). Selected 2026-10-25:
# nvidia/nemotron-3.5-super-vl:free
AI_MODELS=
# Whole-run time limit in seconds (default 30).
AI_TIMEOUT_SECONDS=
